# Public URL of the customer storefront (View Store button, ad links, QR codes, landing preview)
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Express API. The admin app calls this directly.
NEXT_PUBLIC_API_BASE=http://localhost:4000

# TEMP: Phase 2 only. Real third-party calls (Steadfast / Pathao dispatch, Telegram, Facebook Pixel/CAPI test events)
# are SIMULATED by default: no real parcel is booked and nothing live is sent. Set to "true" only deliberately.
ENABLE_LIVE_INTEGRATIONS=false
